# .gitignore

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# Build outputs (if any)
dist/
build/

# Dependencies (if using npm/yarn in future)
node_modules/
package-lock.json
yarn.lock
